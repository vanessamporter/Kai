#!/bin/bash
set -euo pipefail

destination="${1:-}"
if [ -z "${destination}" ]; then
  echo "Usage: bin/backup DESTINATION_DIRECTORY" >&2
  exit 2
fi
if [ -z "${DATABASE_URL:-}" ]; then
  echo "DATABASE_URL is required" >&2
  exit 2
fi

storage_path="${KAI_STORAGE_PATH:-/app/storage}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_path="${destination%/}/kai-${timestamp}"
mkdir -p "${backup_path}"

pg_dump --format=custom --no-owner --no-acl "${DATABASE_URL}" \
  --file="${backup_path}/database.dump"
tar -C "${storage_path}" -czf "${backup_path}/pcaps.tar.gz" .
(
  cd "${backup_path}"
  sha256sum database.dump pcaps.tar.gz > SHA256SUMS
)

echo "Backup written to ${backup_path}"
