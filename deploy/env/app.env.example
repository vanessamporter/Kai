# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY_BASE=generate-a-long-random-secret
DATABASE_URL=postgres://kai:CHANGEME@kai-db/kai_production
KAI_STORAGE_PATH=/app/storage
DJANGO_PRODUCTION=1
DJANGO_ALLOWED_HOSTS=kai.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kai.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
DJANGO_BEHIND_HTTPS_PROXY=1
# Visitors may request accounts, but cannot log in until a staff user approves them.
ALLOW_PUBLIC_SIGNUP=1
REQUIRE_SIGNUP_APPROVAL=1
# Used idempotently at startup. Remove the password from the environment after
# the administrator has been created; later restarts never reset it.
KAI_INITIAL_ADMIN_EMAIL=admin@example.com
KAI_INITIAL_ADMIN_PASSWORD=CHANGEME-use-a-long-random-passphrase
SOURCE_CODE_URL=https://example.com/your/kai-repository

# SMTP is required for signed, time-limited local-account password resets.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=kai@example.com
EMAIL_HOST_PASSWORD=CHANGEME
DEFAULT_FROM_EMAIL=kai@example.com

# Optional LDAP/AD. Use LDAPS, or LDAP_START_TLS=1 with an ldap:// URI.
# LDAP_SERVER_URI=ldaps://directory.example.com
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(mail=%(user)s)
# LDAP_BIND_DN=cn=kai-reader,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=CHANGEME
# LDAP_CA_CERT_FILE=/etc/ssl/certs/directory-ca.pem
# LDAP_REQUIRED_GROUP=cn=kai-users,ou=groups,dc=example,dc=com
# LDAP_ADMIN_GROUP=cn=kai-admins,ou=groups,dc=example,dc=com
